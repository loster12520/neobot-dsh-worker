{
  "name": "neobot-dsh-worker",
  "version": "0.1.0",
  "private": true,
  "description": "DSH bundle: outbound worker daemon driven by NeoBot Router",
  "type": "module",
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./protocol": "./src/protocol.js"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0",
    "dsh": "^0.2.1-rc.2"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "manifestVersion": 1
  },
  "scripts": {
    "test": "node --test tests/*.test.js",
    "check": "node --check src/index.js && node --check src/sync.js && node --check src/protocol.js"
  },
  "files": [
    "src",
    "cordis.patch.yml",
    "PROTOCOL.md",
    "README.md"
  ]
}
